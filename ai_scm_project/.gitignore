# Runtime artifacts can be regenerated, but keep the folders visible.
outputs/**/*.html
outputs/**/*.pptx
outputs/**/*.docx
outputs/**/*.pdf
!outputs/.gitkeep
!outputs/reports/.gitkeep
!outputs/pptx/.gitkeep
!outputs/final/.gitkeep

# Local state snapshots may contain machine-specific paths.
data/run_state.json
data/study_state.json
data/newsletter_state.json
data/progress_state.json
