LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.20-reasoning

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-oss-120b
OPENAI_DEP_TICKET=

MONGODB_URI=local://dev
MONGODB_DB=agentic_ai

STORAGE_DIR=.storage
MAX_CHUNK_CHARS=3000
CHUNK_OVERLAP_CHARS=300
PARSING_AGENT_ENABLED=true
PARSING_AGENT_MAX_PAGES=20
PARSING_AGENT_MAX_CHARS_PER_PAGE=12000

AGENTIC_PDF_API_URL=http://127.0.0.1:8000
AGENTIC_PDF_API_READ_TIMEOUT_SECONDS=600
AGENTIC_PDF_API_STATUS_TIMEOUT_SECONDS=30
